#include <iostream>
using namespace std;

class CQ {
    int *arr;
    int size,cap,front,rear;
    public:
    CQ(int k){
        cap = k;
        arr = new int[cap];
        size = front = 0;
        rear = -1;
    }
    ~CQ(){ delete[] arr;
        cout<<"Destructor\n";}
    bool empty(){ return size==0;}
    bool full(){ return size==cap;}
    void enqueue(int val){
        if(full())
            return;
        rear = (rear + 1) % cap; //0,1 ---cap-1
        arr[rear] = val;
        size++;
    }
    void dequeue(){
        if(empty())
            return;
        front = (front+1) % cap;
        size--;
    }
    int peek(){
        if(empty())
            return -1;
        return arr[front];
        
    }
 
    void print(){
        if(empty())
            return;
        int temp = front;
        for(int i=0;i<size;i++){
            cout<<arr[temp]<<" ";
            temp = (temp + 1) % cap;
        }
        cout<<endl;
    }

};
    int main(){
        CQ q(5);
        q.enqueue(1);
        q.enqueue(2);
        q.enqueue(3);
        q.enqueue(4);
        q.print();
        q.dequeue();
        q.dequeue();
        q.dequeue();
        q.print();
        q.enqueue(50);
        q.enqueue(60);
        q.print();
        return 0;
    }

  
